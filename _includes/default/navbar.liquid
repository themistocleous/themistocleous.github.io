<header class="site-header academic-navbar">
    <div class="navbar-inner">
        <!-- Brand / Academic Identity -->
        <div class="branding">
            <a class="brand-link" href="{{ '/' | relative_url }}" aria-label="{{ site.title }}">
                <span class="brand-accent" aria-hidden="true"></span>
                <div class="brand-text">
                    <span class="site-title">Charalambos (Haris) Themistocleous</span>
                    <span class="site-subtitle">Professor &middot; University of Oslo</span>
                </div>
            </a>
        </div>

        <!-- Navigation Menu -->
        <nav class="main-nav" aria-label="Main Navigation">
            <button type="button" aria-label="Toggle Menu" aria-expanded="false" id="pull" class="nav-toggle-btn">
                <i class="fa-solid fa-bars"></i>
            </button>

            <ul id="nav-menu" class="nav-list hide">
                <li>
                    <a class="nav-item {% if page.url == '/' or page.url == '/about/' %}active{% endif %}" href="{{ '/about/' | relative_url }}">About</a>
                </li>
                <li>
                    <a class="nav-item {% if page.url == '/research/' or page.url == '/software/' %}active{% endif %}" href="{{ '/research/' | relative_url }}">Research</a>
                </li>
                <li>
                    <a class="nav-item {% if page.url == '/publications/' %}active{% endif %}" href="{{ '/publications/' | relative_url }}">Publications</a>
                </li>
                <li>
                    <a class="nav-item {% if page.url == '/obai/' %}active{% endif %}" href="{{ '/obai/' | relative_url }}">Open Brain AI</a>
                </li>
                <li>
                    <a class="nav-item {% if page.url == '/leadership/' %}active{% endif %}" href="{{ '/leadership/' | relative_url }}">Leadership &amp; Teaching</a>
                </li>
                <li>
                    <a class="nav-item {% if page.url == '/contact/' %}active{% endif %}" href="{{ '/contact/' | relative_url }}">Contact</a>
                </li>

            </ul>
        </nav>
    </div>
</header>
