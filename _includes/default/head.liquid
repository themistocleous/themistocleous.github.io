<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Google Fonts: Inter & Lora for Academic Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Icons: Font Awesome 6 & Academicons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jpswalsh/academicons@1/css/academicons.min.css">

    <!-- Academic Stylesheet -->
    <link rel="stylesheet" href="{{ '/assets/css/my.css' | relative_url }}">

    <!-- Favicon -->
    <link rel="shortcut icon" href="{{ site.favicon | relative_url }}" type="image/x-icon">

    <!-- SEO & OpenGraph Tags -->
    <meta property="og:image" content="{{ '/assets/img/me/haris2.png' | absolute_url }}">
    <meta property="og:type" content="website">
    {% seo %}

    <!-- Twitter Cards -->
    <meta name="twitter:title" content="{{ page.title | default: site.title }}">
    <meta name="twitter:description" content="{{ site.description }}">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:image" content="{{ '/assets/img/me/haris2.png' | absolute_url }}">
    <meta name="twitter:image:alt" content="{{ site.title }}">
</head>
